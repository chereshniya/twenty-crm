# Twenty server/worker runtime only. Do not put the Gektar Next.js API key,
# Odoo credentials, legacy SPACES_* credentials or app field identifiers here.

# Use the exact same immutable custom image for server and worker.
TWENTY_IMAGE=registry.example.com/gektar/twenty@sha256:replace-with-tested-digest
SERVER_URL=https://crm.example.com
# Used only when this Compose file publishes the service directly on the host.
# Twenty always listens on port 3000 inside the container.
TWENTY_PORT=8082

# Use a Twenty-owned database. Do not point this at the Gektar/Better Auth
# database. Sharing a PostgreSQL host is acceptable when the databases and
# users are separate.
PG_DATABASE_URL=postgres://user:password@db:5432/twenty
REDIS_URL=redis://redis:6379

# Generate each value independently with: openssl rand -base64 32
# Preserve ENCRYPTION_KEY for the lifetime of this Twenty installation.
ENCRYPTION_KEY=
APP_SECRET=

# Durable Twenty file storage. With presigned URLs enabled, browsers upload
# directly to S3 and downloads are redirected to S3 instead of crossing the
# Twenty server. Configure bucket CORS to allow PUT from SERVER_URL.
STORAGE_S3_REGION=fra1
STORAGE_S3_NAME=gektar-twenty
STORAGE_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PRESIGNED_URL_ENABLED=true
# Set only when STORAGE_S3_ENDPOINT is internal and browsers need another URL.
STORAGE_S3_PRESIGNED_URL_BASE=
STORAGE_S3_PRESIGNED_URL_EXPIRES_IN=900
